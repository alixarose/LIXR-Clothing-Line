# ============================================================
# LIXR LOCAL / ONLINE CONFIGURATION
# Frontend: HTML + CSS + JavaScript
# Backend : Go
# Database: SQLite
# ============================================================

# APPLICATION / PORTS
APP_NAME=Lixr
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3017
LOCAL_HTTP_PORT=3017

# ALLOWED DOMAINS / ORIGINS
ALLOWED_HOSTS=127.0.0.1,localhost,lixr.jpano.dev
PUBLIC_URL_127=http://127.0.0.1:3017
PUBLIC_URL_LOCALHOST=http://localhost:3017
PUBLIC_URL_ONLINE=https://lixr.jpano.dev

# SQLITE
DATABASE_DRIVER=sqlite
DATABASE_PATH=../database/lixr.db

# GOOGLE OAUTH
# Add all three callback URLs to the same Google OAuth client when enabling it.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_127=http://127.0.0.1:3017/api/auth/google/callback
GOOGLE_REDIRECT_URI_LOCALHOST=http://localhost:3017/api/auth/google/callback
GOOGLE_REDIRECT_URI_ONLINE=https://lixr.jpano.dev/api/auth/google/callback

# SMTP
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lixr

# SESSION / COOKIES
SESSION_SECRET=change-this-before-online-production
SESSION_HOURS=12
COOKIE_SECURE=false
